#!/bin/sh
#
# Pre-push gate: the rendered viewer.  NOT INSTALLED - kept for machines that want it.
#
# install-hooks.ps1 no longer copies this file into .git/hooks. It is still tracked because a repository
# whose pushes are rare does not need a viewer gate on every push, and because the hook is the only place
# that explains why viewcheck is not in pre-commit: it needs a real GL context, so it cannot run on a build
# machine.
#
# To install it on a machine that always has a display:
#     Copy-Item hooks/pre-push .git/hooks/pre-push          (PowerShell)
#     cp hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# Or just run the gate, which is the same thing without a hook:
#     gradlew :desktop:viewcheck
#
# It used to take ~220 seconds, which is what made it a push hook rather than a commit hook. It now
# defaults to 8 concurrent children and takes ~36s for the same 17 recordings (ViewCheck.parallelism), so
# that reason is much weaker than it was - but a reporting hook on every push is still not a check anyone
# reads twice.
#
# ---------------------------------------------------------------------------------------------------
#
# Pre-push gate: the rendered viewer.
#
# Runs :desktop:viewcheck, which plays the committed corpus the way a person plays it - real GameScene,
# real frame driver, real GL context - and is the only check that can see a fault in the render loop.
# It lives here rather than in pre-commit for two reasons: it took about 220 seconds, and it needs a real
# GL context, so it is neither quick enough for a commit nor runnable everywhere a commit is.
#
# IT DOES NOT BLOCK THE PUSH, and that is deliberate rather than an oversight.
#
# An earlier version of this header said viewcheck was "red by design", and that was true when it was
# written: 7-9 of the 17 committed recordings diverged in the viewer while all 17 verified clean
# headlessly (superintelligence/ISSUE-viewer-frame-drift.md). That issue is FIXED, and the gate is green
# on all 17 - measured, not quoted. The reason for staying non-blocking is therefore no longer "it fails";
# it is that it needs a display, and a pre-push hook that cannot run on a build machine gets deleted by
# the first person it blocks. It reports, so the number is on the screen every time.
#
# Turning it into a blocking gate is a one-line change - `exit 0` at the bottom becomes `exit 1` on a
# non-zero result - and is the right call on a machine that always has a GL context. It is left
# undecided here rather than decided for whoever pushes next.
#
# Make it blocking, and read the failure list rather than the count: viewcheck forks one JVM per
# recording and playback is timing-sensitive by its own nature, so the *membership* of a failing set is
# more informative than how many failed. Set VIEWCHECK_JOBS=1 to make the failing steps reproducible
# too - see TODO.md §0.7 for a divergence that was reported by hand, never reproduced in ~50 automated
# attempts, and is a different shape from a stream or ordering fault.

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root" || exit 1

echo "[INFO] running :desktop:viewcheck (the rendered viewer; needs a GL context, takes ~220s)"
echo "[INFO] green is the expected result. Reporting only - this hook does not block the push."

if ./gradlew --quiet :desktop:viewcheck; then
    echo ""
    echo "[OK]   every committed recording played clean in the viewer."
else
    echo ""
    echo "[WARN] viewer gate failed. The recordings are listed above; compare the set against the"
    echo "[WARN] previous run rather than the count, since playback is timing-sensitive."
    echo "[WARN] history: superintelligence/ISSUE-viewer-frame-drift.md (fixed),"
    echo "[WARN]           superintelligence/TODO.md 0.7 (a reported divergence, not reproduced)."
fi

exit 0