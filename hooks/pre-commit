#!/bin/sh

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

git_dir=$(git rev-parse --absolute-git-dir)
unstaged_patch="$git_dir/pre-commit-unstaged.patch"
untracked_dir="$git_dir/pre-commit-untracked"
untracked_list="$git_dir/pre-commit-untracked.list"

if [ -e "$unstaged_patch" ] || [ -e "$untracked_dir" ]; then
    echo "[ERROR] an earlier pre-commit run left work set aside and could not restore it:"
    echo "        $unstaged_patch (git apply it) and $untracked_dir (move its files back)."
    echo "        Restore them, delete both, and commit again."
    exit 1
fi

restore_worktree() {
    _status=$?
    trap - EXIT INT TERM
    set +e
    if [ -d "$untracked_dir" ]; then
        while IFS= read -r _f; do
            if [ -e "$untracked_dir/$_f" ]; then
                mkdir -p "$(dirname "$_f")"
                mv "$untracked_dir/$_f" "$_f" || _status=1
            fi
        done < "$untracked_list"
        if [ -z "$(find "$untracked_dir" -type f 2>/dev/null | head -1)" ]; then
            rm -rf "$untracked_dir" "$untracked_list"
        else
            echo "[ERROR] some untracked files could not be moved back; they are under $untracked_dir"
            _status=1
        fi
    fi
    rm -f "$untracked_list"
    if [ -s "$unstaged_patch" ]; then
        if git apply --binary --whitespace=nowarn "$unstaged_patch"; then
            rm -f "$unstaged_patch"
        else
            echo "[ERROR] could not restore unstaged changes; they are saved in $unstaged_patch"
            exit 1
        fi
    else
        rm -f "$unstaged_patch"
    fi
    exit $_status
}

git diff --binary > "$unstaged_patch"
git ls-files --others --exclude-standard > "$untracked_list"
trap restore_worktree EXIT
trap 'exit 130' INT TERM

if [ -s "$unstaged_patch" ]; then
    git checkout -- .
fi
if [ -s "$untracked_list" ]; then
    while IFS= read -r _f; do
        mkdir -p "$untracked_dir/$(dirname "$_f")"
        mv "$_f" "$untracked_dir/$_f"
    done < "$untracked_list"
else
    rm -f "$untracked_list"
fi

set_badge() {
    _file="$1"; _label="$2"; _have="$3"; _want="$4"

    if [ -z "$_have" ]; then
        echo "[ERROR] no '$_label' badge found in $_file."
        return 1
    fi

    if [ "$_have" = "$_want" ]; then
        return 0
    fi

    echo "[INFO] $_file '$_label' badge says $_have, the correct version is $_want. correcting it."
    sed "s|img.shields.io/badge/$_label-$_have-blue.svg|img.shields.io/badge/$_label-$_want-blue.svg|g" \
        "$_file" > "$_file.tmp"
    mv "$_file.tmp" "$_file"
    git add "$_file"
    echo "[OK]   $_file '$_label' badge updated to $_want and staged."
    return 0
}

read_badge() {
    grep -a -o "img.shields.io/badge/$2-[0-9][^-]*-blue.svg" "$1" \
        | head -1 \
        | sed "s|.*$2-||; s|-blue.svg||"
}

game_version=$(git tag --list 'v[0-9]*' --sort=-v:refname 2>/dev/null | head -1 | sed 's/^v//')

if [ -z "$game_version" ]; then
    echo "[WARN] no v* tag in this clone, so the game's version badge cannot be checked."
    echo "[WARN] fetch tags with 'git fetch --tags' to have it checked."
else
    readme_game=$(read_badge README.md 'version')
    set_badge README.md 'version' "$readme_game" "$game_version"
fi

for _md in README.md $(ls superintelligence/*.md docs/*.md 2>/dev/null); do
    if LC_ALL=C tr -d '\11\12\15\40-\376' < "$_md" | grep -q . 2>/dev/null; then
        echo "[ERROR] $_md carries a control byte."
        echo "        grep reads such a file as binary, so the badge checks below cannot be trusted."
        echo "        :superintelligence:doccheck names the offending file and the byte offsets."
        exit 1
    fi
done

si_changelog_version=$(grep -a -o '^## \[[0-9][^]]*\]' superintelligence/CHANGELOG.md \
    | head -1 \
    | sed 's/^## \[//; s/\]$//')

if [ -z "$si_changelog_version" ]; then
    echo "[ERROR] could not read a released version heading from superintelligence/CHANGELOG.md."
    echo "        Expected a line like '## [1.2.3] - 2026-10-09'."
    exit 1
fi

si_readme_version=$(read_badge superintelligence/README.md 'version')
set_badge superintelligence/README.md 'version' "$si_readme_version" "$si_changelog_version"

root_si_version=$(read_badge README.md 'superintelligence')
set_badge README.md 'superintelligence' "$root_si_version" "$si_changelog_version"

echo "[INFO] running verifyall (:superintelligence:gates + :desktop:playbackcheck) on the staged tree"

if ! ./gradlew --quiet verifyall; then
    echo ""
    echo "[ERROR] the gate suite failed. The commit was not made."
    echo "        Run './gradlew verifyall' on its own to see which gate, and why."
    exit 1
fi

exit 0
