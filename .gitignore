# Built application files
*.apk

# Files for the Dalvik VM
*.dex

# Java class files
*.class

# Gradle build files
.gradle/
build/
release/

# Local configuration file (sdk path, etc)
local.properties

# Real environment overrides for the :superintelligence module. .env.example beside it, in
# superintelligence/, is the tracked template; a run with no .env uses the compiled defaults, which are
# exactly the values in superintelligence/superintelligence.properties.
#
# A bare name, so it matches at any depth: the template moved into the module and .env is expected to
# move with it, and a pattern of /superintelligence/.env would silently stop matching the moment it did.
.env

#intellij project files
*.iml
*.idea

# LWJGL extracts its native libraries into the working directory on first run. Nothing here is ours, it
# is rebuilt from the jar, and viewcheck creates it under the repo root because that is its working dir.
.lwjgl/
/superintelligence/trainer-replays

# Run artefacts: weights, checkpoints, metrics CSVs, replay directories, traces. Evidence a run
# produced belongs in the repository, not in the system temp directory, and none of it belongs in
# version control. The .gitkeep keeps the directory itself tracked so it exists on a fresh clone.
/superintelligence/out/*
!/superintelligence/out/.gitkeep


# Same directory as above, for a command launched from the repository root before the module was found.
/out/

/.claude
/superintelligence/out
