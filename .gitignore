# Built application files
*.apk

# Files for the Dalvik VM
*.dex

# Java class files
*.class

# Gradle build files
.gradle/
build/
release/

# Local configuration file (sdk path, etc)
local.properties

# Real environment overrides for the :superintelligence module. .env.example is the tracked template;
# a run with no .env uses the compiled defaults, which are exactly the values in
# superintelligence/superintelligence.properties.
.env

#intellij project files
*.iml
*.idea

# LWJGL extracts its native libraries into the working directory on first run. Nothing here is ours, it
# is rebuilt from the jar, and viewcheck creates it under the repo root because that is its working dir.
.lwjgl/
